// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User{
  id Int @id @default(autoincrement())
  name String @db.VarChar(75)
  email String @db.VarChar(255) @unique
  password String @db.VarChar(255)
  refresh_token String? @db.Text
  refresh_token_expires_at DateTime?
  is_verified Boolean @default(false)
  avatar_url String? @db.VarChar(255)
  reset_token String? @db.Text
  reset_token_expires_at DateTime?
  email_verification_token String? @db.Text
  email_verification_token_expires_at DateTime?
  bookings Booking[]
  review Review[]
  payment Payment[]
  notifications Notifications[]
}

enum TripCategory {
  ADVENTURE
  CITY_BREAK
  BEACH
  MOUNTAIN
  CULTURAL
  CRUISE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Trip {
  id Int @id @default(autoincrement())
  title String @db.VarChar(255)
  country_code String @db.VarChar(10)
  price Decimal @db.Decimal(10, 2)
  total_seats Int
  available_seats Int
  category TripCategory
  description      String       @db.Text
  start_date       DateTime     @db.Timestamp(0)
  end_date         DateTime     @db.Timestamp(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  bookings          Booking[]
  images           Image[]
  notifications     Notifications[]
  review Review[]
  @@map("trips")
}

model Image {
  id  Int     @id @default(autoincrement())
  trip_id   Int
  url       String  @db.VarChar(255)
  is_cover  Boolean @default(false)
  trip      Trip    @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  @@index([trip_id])
  @@map("images")
}

model Booking {
  id Int @id @default(autoincrement())
  user_id Int
  trip_id Int
  total_price  Decimal @default(0) @db.Decimal(10, 2)
  seats_booked Int @default(1)
  status BookingStatus @default(CONFIRMED)
  createdAt DateTime @default(now())
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)
  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Restrict)
  payment Payment[]
  review Review[]
  @@unique([user_id, trip_id])
  @@map("bookings")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

model Payment {
  id Int @id @default(autoincrement())
  user_id Int
  booking_id Int
  stripe_payment_intent_id String? @db.VarChar(255) @unique
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  amount Decimal @db.Decimal(10, 2)
  status PaymentStatus @default(PENDING)
}

model Notifications{
  id Int @id @default(autoincrement())
  user_id Int
  trip_id Int?
  message String @db.Text
  type String @db.VarChar(255)
  createdAt DateTime @default(now())
  was_read Boolean @default(false)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [trip_id], references: [id], onDelete: Cascade)
}

model Review {
  id         Int      @id @default(autoincrement())
  rating     Int      
  comment    String  
  user_id    Int
  trip_id    Int
  booking_id Int      @unique 
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip       Trip     @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  booking    Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  @@map("reviews")
}