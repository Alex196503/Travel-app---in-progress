{
  "name": "vite-project",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev:fe": "react-router dev",
    "dev:be": "tsx watch app/server/server.ts",
    "dev": "concurrently --raw \"npm run dev:fe\" \"npm run dev:be\"",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "migrateImages": "tsx app/utils/cloudinary-images-upload.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-router/node": "8.0.0",
    "@react-router/serve": "8.0.0",
    "@types/express": "^5.0.6",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "isbot": "^5.1.36",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router": "8.0.0",
    "react-spinners": "^0.17.0",
    "react-toastify": "^11.1.0",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/stripe": "^8.0.416",
    "concurrently": "^10.0.4",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-plugin-devtools-json": "^1.1.0"
  }
}
